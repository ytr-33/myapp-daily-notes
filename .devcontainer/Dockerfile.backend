FROM maven:3.9-eclipse-temurin-17

# Install additional tools
RUN apt-get update && apt-get install -y \
        git \
        postgresql-client \
        sudo \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Create vscode user with .m2 setup
RUN useradd -m -s /bin/bash vscode \
    && echo "vscode ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers \
    && mkdir -p /home/vscode/.m2/repository \
    && chown -R vscode:vscode /home/vscode/.m2

# Set working directory
WORKDIR /workspace

# Switch to vscode user
USER vscode

# Set JAVA_HOME in user's bashrc (maven image already has it, but ensure it's in shell)
RUN echo "export JAVA_HOME=\$JAVA_HOME" >> /home/vscode/.bashrc

# Keep container running
CMD ["/bin/bash"]
